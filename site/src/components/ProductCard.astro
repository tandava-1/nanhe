---
import { inr, type Product } from '../data/catalog';
interface Props { p: Product }
const { p } = Astro.props;
const search = [p.name, p.hindi, p.cat.name, p.line, p.age, p.size, ...p.hero, p.friend?.name ?? '', p.friend?.animal ?? '', p.caution ?? '', p.routines.join(' ')].join(' ').toLowerCase();
---
<article class="pcard" data-cat={p.category} data-slug={p.slug} data-routines={p.routines.join(' ')}
  data-price={p.price} data-rating={p.rating} data-reviews={p.reviewCount} data-agemin={p.ageMin} data-agemax={p.ageMax} data-search={search}>
  <a href={`/products/${p.slug}`} class="pimg" tabindex="-1" aria-hidden="true">
    <img src={p.pack} alt="" loading="lazy" width="240" height="240" />
  </a>
  {p.warnShort && <span class="badge">{p.warnShort}</span>}
  <div class="pbody">
    <span class="lbl deep pe">{p.cat.name} · {p.age}</span>
    <h3 class="f pn"><a href={`/products/${p.slug}`}>{p.name}</a></h3>
    <span class="hi mu ph" lang="hi">{p.hindi}</span>
    <p class="pl mu">{p.line}</p>
    <p class="pr"><b>★ {p.rating}</b> · {p.reviewCount} reviews · {p.buyAgain}% buy again</p>
    <div class="pf">
      <span class="pp">{inr(p.price)} <span class="pq">· {p.size}</span></span>
      <button class="add" type="button" data-add={p.slug} data-name={p.name} aria-label={`Add ${p.name} to cart`}>Add</button>
    </div>
  </div>
</article>

<style>
  /* One card format everywhere (Home, Shop, Search, product pages), always placed in a .pgrid so every card on
     the site is the same size: a square image, then text lines with a fixed number of lines each (clamped, with
     room reserved). Product-specific safety notes sit on the image as a badge rather than adding a line; the full
     caution text is on the product page. */
  .pcard { position: relative; background: var(--white); border: 1px solid rgba(31, 58, 43, .10); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; height: 100%; }
  .pimg { background: var(--w); position: relative; display: block; aspect-ratio: 1; overflow: hidden; }
  .pimg img { position: absolute; inset: 6%; width: 88%; height: 88%; object-fit: contain; }
  .badge { position: absolute; z-index: 1; top: 8px; left: 8px; right: 8px; width: max-content; max-width: calc(100% - 16px); background: var(--white); color: var(--moss); font-size: 10px; font-weight: 700; line-height: 1.25; padding: 3px 7px; border-radius: 8px; box-shadow: 0 0 0 1px rgba(31, 58, 43, .14); }
  .pbody { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .pe { font-size: 9px; letter-spacing: .12em; line-height: 1.35; min-height: 2.7em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pn { font-size: 16px; line-height: 1.2; min-height: 2.4em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pn a { text-decoration: none; }
  .pn a::after { content: ''; position: absolute; inset: 0; }
  .ph { font-size: 12px; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl { font-size: 12px; line-height: 1.4; min-height: 2.8em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pr { font-size: 12px; line-height: 1.4; min-height: 2.8em; margin-top: 2px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pf { display: flex; flex-direction: column; align-items: stretch; gap: 8px; margin-top: auto; padding-top: 8px; }
  .pp { font-weight: 600; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pq { font-size: 12px; color: var(--moss-2); font-weight: 400; }
  .add { position: relative; z-index: 1; min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--moss); background: var(--white); font-weight: 600; font-size: 14px; cursor: pointer; }
  .add:hover { background: var(--moss); color: var(--milk); }
  @media (min-width: 720px) {
    .pcard { border-radius: var(--radius); }
    .badge { top: 12px; left: 12px; font-size: 11px; }
    .pbody { padding: 18px 20px 20px; gap: 3px; }
    .pe { font-size: 10px; letter-spacing: .16em; }
    .pn { font-size: 21px; }
    .ph { font-size: 15px; }
    .pl { font-size: 14px; margin-top: 4px; }
    .pr { font-size: 14px; margin-top: 6px; }
    .pf { flex-direction: row; align-items: center; justify-content: space-between; }
    .add { flex: none; }
  }
</style>
