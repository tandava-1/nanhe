---
import { inr, type Product } from '../data/catalog';
interface Props { p: Product; layout?: 'auto' | 'tile' }
const { p, layout = 'auto' } = Astro.props;
---
<article class:list={['pcard', `pcard-${layout}`]} data-cat={p.category} data-slug={p.slug} data-routines={p.routines.join(' ')}
  data-price={p.price} data-rating={p.rating} data-reviews={p.reviewCount} data-agemin={p.ageMin} data-agemax={p.ageMax}>
  <a href={`/products/${p.slug}`} class="pimg" tabindex="-1" aria-hidden="true">
    <img src={p.pack} alt="" loading="lazy" width="240" height="240" />
  </a>
  <div class="pbody">
    <span class="lbl deep pe">{p.cat.name} · {p.age}</span>
    <h3 class="f pn"><a href={`/products/${p.slug}`}>{p.name}</a></h3>
    <span class="hi mu ph" lang="hi">{p.hindi}</span>
    <p class="pl mu">{p.line}</p>
    <p class="pr"><b>★ {p.rating}</b> · {p.reviewCount} reviews · {p.buyAgain}% buy again</p>
    {p.warnShort && <p class="pw">{p.warnShort}</p>}
    <div class="pf">
      <span class="pp">{inr(p.price)} <span class="pq">· {p.size}</span></span>
      <button class="add" type="button" data-add={p.slug} data-name={p.name} aria-label={`Add ${p.name} to cart`}>Add</button>
    </div>
  </div>
</article>

<style>
  .pcard { background: var(--white); border: 1px solid rgba(31, 58, 43, .10); border-radius: var(--radius); overflow: hidden; display: grid; grid-template-columns: 108px minmax(0, 1fr); }
  .pimg { background: var(--w); display: flex; align-items: center; justify-content: center; }
  .pimg img { width: 100%; height: 100%; max-height: 160px; object-fit: contain; }
  .pbody { padding: 12px 14px; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pe { font-size: 10px; }
  .pn { font-size: 18px; line-height: 1.2; }
  .pn a { text-decoration: none; }
  .pn a::after { content: ''; position: absolute; inset: 0; }
  .pcard { position: relative; }
  .ph { font-size: 13px; }
  .pl { font-size: 12px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pr { font-size: 12px; margin-top: 2px; }
  .pw { font-size: 12px; font-weight: 600; }
  .pf { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 8px; }
  .pp { font-weight: 600; font-size: 15px; }
  .pq { font-size: 12px; color: var(--moss-2); font-weight: 400; }
  .add { position: relative; z-index: 1; min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--moss); background: var(--white); font-weight: 600; font-size: 14px; cursor: pointer; }
  .add:hover { background: var(--moss); color: var(--milk); }
  .pcard-tile { display: flex; flex-direction: column; }
  .pcard-tile .pimg { aspect-ratio: 1; }
  .pcard-tile .pimg img { max-height: none; }
  @media (min-width: 720px) {
    .pcard { display: flex; flex-direction: column; }
    .pimg { aspect-ratio: 1; }
    .pimg img { max-height: none; }
    .pbody { padding: 18px 20px 20px; gap: 3px; flex: 1; }
    .pn { font-size: 22px; }
    .ph { font-size: 15px; }
    .pl { font-size: 14px; margin-top: 4px; }
    .pr { font-size: 14px; margin-top: 6px; }
  }
</style>
