---
// The Nanhe wordmark, inlined from assets/logo/nanhe-wordmark.svg so it can be recoloured.
// Leaf stays leaf green on light grounds and pale sage on moss (brand book: never recolour it otherwise).
interface Props { reversed?: boolean; height?: number; label?: string }
const { reversed = false, height = 30, label = 'Nanhe' } = Astro.props;
const ink = reversed ? '#FBF7F0' : '#1F3A2B';
const leaf = reversed ? '#BFD6B0' : '#5E8E4E';
---
<svg viewBox="-6 -20 426 134" height={height} width={height * 426 / 134} role="img" aria-label={label}>
  <g fill="none" stroke={ink} stroke-width="14" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 40V100M7 68a28 28 0 0 1 56 0V100" />
    <circle cx="121" cy="70" r="30" />
    <path d="M151 40V100" />
    <path d="M181 40V100M181 68a28 28 0 0 1 56 0V100" />
    <path d="M267 14V100M267 68a28 28 0 0 1 56 0V100" />
    <path d="M351 70H411A30 30 0 1 0 402.2 91.2" />
  </g>
  <path d="M267 12Q295 16 297 -14Q269 -16 267 12Z" fill={leaf} />
</svg>
