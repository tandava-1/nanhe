---
import Base from '../layouts/Base.astro';
import CatalogData from '../components/CatalogData.astro';
import ProductCard from '../components/ProductCard.astro';
import { bySlug } from '../data/catalog';
const alsoAdd = ['diaper-rash-cream', 'water-wipes', 'daily-lotion', 'all-purpose-balm'].map((s) => bySlug[s]);
---
<Base title="Your cart · Nanhe">
  <CatalogData />
  <section class="wrap cart-wrap">
    <h1 class="f h2">Your cart <span class="mu count" data-count></span></h1>

    <div class="cart-grid" data-full hidden>
      <div class="cart-main">
        <div class="card freebar" data-freebar>
          <p class="sm" data-freetext></p>
          <div class="track"><span data-freefill></span></div>
        </div>
        <ul class="lines" data-lines></ul>

        <div class="tip"><span class="tl">Parent tip</span>A pack of 72 wipes lasts most families a few days in the newborn months, at 8 to 12 changes a day. On subscription you can change how often it comes, any time.</div>

        <div class="card gift">
          <label class="switch-row"><span><b>This is a gift</b><span class="sm mu block">Add a note and leave prices off the invoice</span></span><input type="checkbox" role="switch" data-gift /></label>
          <div class="gift-body" data-giftbody hidden>
            <label for="gnote" class="sm" style="font-weight:600">Gift note</label>
            <textarea id="gnote" class="input area" maxlength="240" placeholder="Congratulations! Wishing the little one…" data-giftnote></textarea>
            <label class="check sm"><input type="checkbox" data-hideprices checked /> Don't show prices on the invoice</label>
          </div>
        </div>
      </div>

      <aside class="cart-side">
        <div class="card side-card">
          <form class="row-form" data-pin>
            <label for="pin" class="sm" style="font-weight:600">Delivery pincode</label>
            <div class="row"><input id="pin" class="input" inputmode="numeric" maxlength="6" placeholder="6-digit pincode" autocomplete="postal-code" /><button class="btn2" type="submit">Check</button></div>
            <p class="xs mu" data-pinmsg aria-live="polite">Cash on delivery available on one-time orders</p>
          </form>
          <form class="row-form" data-coupon>
            <label for="coupon" class="sm" style="font-weight:600">Coupon</label>
            <div class="row"><input id="coupon" class="input" placeholder="Try NANHE10" autocapitalize="characters" /><button class="btn2" type="submit">Apply</button></div>
            <p class="xs mu" data-couponmsg aria-live="polite"></p>
          </form>
          <dl class="sum" data-sum></dl>
          <a class="btn btn-block" href="/checkout" data-checkout>Checkout</a>
          <p class="xs mu" style="text-align:center">UPI · Cards · Netbanking · Cash on delivery <span class="smp">sample prices</span></p>
        </div>
      </aside>
    </div>

    <div class="empty" data-empty hidden>
      <img src="/brand/characters/haathi.svg" alt="" width="96" height="96" />
      <p class="f h3">Your cart is empty</p>
      <p class="mu">Find what suits your baby, or start with the products parents love most.</p>
      <div class="row wrap-row" style="gap:12px;justify-content:center"><a class="btn" href="/shop">Shop the range</a><a class="btn2" href="/kits">See kits</a></div>
    </div>
  </section>

  <section class="wrap stack" style="gap:20px;padding-bottom:64px">
    <h2 class="f h3">Parents also add</h2>
    <div class="pgrid">{alsoAdd.map((p) => <ProductCard p={p} />)}</div>
  </section>
</Base>

<style>
  .cart-wrap { padding-top: 24px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 20px; }
  .count { font-family: var(--sans); font-size: 16px; font-weight: 400; letter-spacing: 0; }
  .cart-grid { display: flex; flex-direction: column; gap: 20px; }
  .cart-main { display: flex; flex-direction: column; gap: 14px; flex: 1 1 560px; min-width: 0; }
  .cart-side { flex: 0 1 380px; }
  @media (min-width: 960px) { .cart-grid { flex-direction: row; align-items: flex-start; gap: 32px; } .cart-side { position: sticky; top: 100px; } }
  .freebar { padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; background: var(--oat); border: 0; }
  .track { height: 8px; background: rgba(31, 58, 43, .12); border-radius: 4px; overflow: hidden; }
  .track span { display: block; height: 8px; background: var(--moss); border-radius: 4px; width: 0; transition: width .3s; }
  .lines { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .gift { padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }
  .switch-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: pointer; }
  .switch-row input { width: 22px; height: 22px; accent-color: var(--moss); flex: none; }
  .block { display: block; }
  .gift-body { display: flex; flex-direction: column; gap: 8px; }
  .area { border-radius: 16px; min-height: 84px; padding: 12px 14px; resize: vertical; }
  .check { display: flex; gap: 10px; align-items: center; min-height: 40px; }
  .check input { width: 18px; height: 18px; accent-color: var(--moss); }
  .side-card { padding: 18px; display: flex; flex-direction: column; gap: 14px; }
  .row-form { display: flex; flex-direction: column; gap: 6px; }
  .row-form .row .btn2 { flex: none; min-height: 48px; }
  .sum { margin: 0; display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; font-size: 15px; border-top: 1px solid var(--line); padding-top: 14px; }
  .sum dd { margin: 0; text-align: right; }
  .empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; padding: 32px 0 16px; }
  .btn[aria-disabled="true"] { opacity: .45; pointer-events: none; }
</style>

<style is:global>
  .line { background: var(--white); border: 1px solid rgba(31, 58, 43, .10); border-radius: 18px; padding: 12px; display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 12px; }
  .line-img { width: 84px; height: 84px; border-radius: 14px; background: var(--w); position: relative; overflow: hidden; display: block; }
  .line-img img { position: absolute; inset: 6%; width: 88%; height: 88%; object-fit: contain; }
  .line-img.photo img { inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .line-body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .line-top { display: flex; justify-content: space-between; gap: 8px; align-items: flex-start; }
  .line-name { font-size: 18px; line-height: 1.2; text-decoration: none; }
  .line-meta { font-size: 12px; color: var(--moss-2); }
  .line-x { width: 36px; height: 36px; border: 0; background: none; border-radius: 18px; cursor: pointer; flex: none; display: inline-flex; align-items: center; justify-content: center; }
  .line-x:hover { background: rgba(31, 58, 43, .06); }
  .line-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-top: 6px; }
  .qty { display: inline-flex; align-items: center; border: 1px solid var(--line-2); border-radius: 999px; }
  .qty button { width: 40px; height: 40px; border: 0; background: none; font-size: 18px; cursor: pointer; border-radius: 20px; }
  .qty span { min-width: 22px; text-align: center; font-weight: 600; }
  .line-price { font-weight: 600; text-align: right; }
  .line-price s { color: var(--moss-2); font-weight: 400; font-size: 13px; margin-right: 6px; }
  .sub-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 13px; }
  .sub-row input { width: 18px; height: 18px; accent-color: var(--moss); }
  .sub-row select { border: 0; background: none; font-weight: 600; text-decoration: underline; padding: 0; }
</style>

<script>
  import { catalog, inr, esc, toast } from '../scripts/data';
  import { readCart, writeCart, unitPrice, totals, readCoupon, writeCoupon, readGift, writeGift, type CartLine } from '../scripts/cart';

  const c = catalog();
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const linesEl = $('[data-lines]');

  function lineHtml(l: CartLine) {
    const qty = `<div class="qty"><button type="button" data-dec="${l.id}" aria-label="One less">−</button><span>${l.qty}</span><button type="button" data-inc="${l.id}" aria-label="One more">+</button></div>`;
    const x = `<button type="button" class="line-x" data-rm="${l.id}" aria-label="Remove"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>`;
    const gross = unitPrice(l, c) * l.qty;
    const net = l.subscribe ? gross - Math.round(gross * c.rules.subDiscount) : gross;
    const price = `<div class="line-price">${l.subscribe ? `<s>${inr(gross)}</s>` : ''}${inr(net)}</div>`;
    if (l.kind === 'product') {
      const p = c.products[l.slug]; if (!p) return '';
      const sub = p.subscribe ? `<label class="sub-row"><input type="checkbox" data-sub="${l.id}" ${l.subscribe ? 'checked' : ''}/> Subscribe &amp; save ${Math.round(c.rules.subDiscount * 100)}%${l.subscribe ? ` · every <select data-every="${l.id}" aria-label="Delivery frequency">${(p.category === 'diapering' ? ['2 weeks', '4 weeks', '6 weeks'] : ['4 weeks', '6 weeks', '8 weeks']).map((f) => `<option ${f === l.every ? 'selected' : ''}>${f}</option>`).join('')}</select>` : ''}</label>` : '';
      return `<li class="line" data-cat="${p.category}"><a class="line-img" href="/products/${p.slug}" tabindex="-1" aria-hidden="true"><img src="${p.pack}" alt=""/></a>
        <div class="line-body"><div class="line-top"><div><a class="f line-name" href="/products/${p.slug}">${esc(p.name)}</a><div class="line-meta">${esc(p.size)} · ${esc(p.age)}${p.warnShort ? ` · <b>${esc(p.warnShort)}</b>` : ''}</div></div>${x}</div>
        ${sub}<div class="line-bottom">${qty}${price}</div></div></li>`;
    }
    const items = l.kind === 'kit' ? c.kits[l.slug]?.items ?? [] : l.items ?? [];
    const name = l.kind === 'kit' ? c.kits[l.slug]?.name ?? 'Kit' : `Your own box (${items.length} items)`;
    const cat = l.kind === 'kit' ? c.kits[l.slug]?.cat ?? '' : 'bath';
    const img = l.kind === 'kit' && l.slug === 'newborn-starter' ? `<span class="line-img photo"><img src="/brand/renders/ai-03-changing-kit.jpg" alt=""/></span>` : `<span class="line-img"><img src="${c.products[items[0]]?.pack ?? ''}" alt=""/></span>`;
    return `<li class="line" data-cat="${cat}">${img}<div class="line-body"><div class="line-top"><div><span class="f line-name">${esc(name)}</span><div class="line-meta">${items.map((s) => esc(c.products[s]?.name ?? s)).join(' · ')}</div></div>${x}</div><div class="line-bottom">${qty}${price}</div></div></li>`;
  }

  function render() {
    const lines = readCart();
    const t = totals(lines);
    $('[data-full]').hidden = lines.length === 0;
    $('[data-empty]').hidden = lines.length > 0;
    $('[data-count]').textContent = lines.length ? `· ${t.items} item${t.items === 1 ? '' : 's'}` : '';
    linesEl.innerHTML = lines.map(lineHtml).join('');
    $('[data-freetext]').innerHTML = t.toFree > 0 ? `<b>${inr(t.toFree)} away from free delivery</b>` : '<b>You get free delivery</b>';
    $('[data-freefill]').style.width = `${Math.min(100, ((c.rules.freeDelivery - t.toFree) / c.rules.freeDelivery) * 100)}%`;
    const rows: [string, string][] = [[`Items (${t.items})`, inr(t.subtotal)]];
    if (t.subSave) rows.push(['Subscription savings', `−${inr(t.subSave)}`]);
    if (t.couponSave) rows.push([`Coupon ${t.code}`, `−${inr(t.couponSave)}`]);
    rows.push(['Delivery', t.delivery ? inr(t.delivery) : 'Free']);
    $('[data-sum]').innerHTML = rows.map(([a, b]) => `<dt>${a}</dt><dd>${b}</dd>`).join('') + `<dt style="font-weight:700;font-size:17px">Total</dt><dd style="font-weight:700;font-size:17px">${inr(t.total)}</dd><dt class="xs mu" style="grid-column:1/-1">Incl. of all taxes</dt>`;
    if (readCoupon()) $<HTMLInputElement>('#coupon').value = readCoupon();
  }

  function update(id: string, fn: (l: CartLine) => void) {
    const lines = readCart(); const l = lines.find((x) => x.id === id); if (!l) return;
    fn(l); writeCart(lines.filter((x) => x.qty > 0)); render();
  }

  linesEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const inc = t.closest<HTMLElement>('[data-inc]'), dec = t.closest<HTMLElement>('[data-dec]'), rm = t.closest<HTMLElement>('[data-rm]');
    if (inc) update(inc.dataset.inc!, (l) => { l.qty = Math.min(9, l.qty + 1); });
    if (dec) update(dec.dataset.dec!, (l) => { l.qty -= 1; });
    if (rm) { update(rm.dataset.rm!, (l) => { l.qty = 0; }); toast('Removed from cart.'); }
  });
  linesEl.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement & HTMLSelectElement;
    if (t.dataset.sub) {
      const lines = readCart(); const l = lines.find((x) => x.id === t.dataset.sub); if (!l) return;
      const want = t.checked; const id = `${l.slug}${want ? ':sub' : ''}`;
      const other = lines.find((x) => x.id === id);
      if (other) { other.qty += l.qty; l.qty = 0; } else { l.subscribe = want; l.id = id; l.every = want ? '6 weeks' : undefined; }
      writeCart(lines.filter((x) => x.qty > 0)); render();
    }
    if (t.dataset.every) update(t.dataset.every, (l) => { l.every = t.value; });
  });

  // Pincode: prototype only. Any valid Indian pincode gets a date three working days out.
  $('[data-pin]').addEventListener('submit', (e) => {
    e.preventDefault();
    const v = $<HTMLInputElement>('#pin').value.trim(); const msg = $('[data-pinmsg]');
    if (!/^[1-8]\d{5}$/.test(v)) { msg.textContent = 'Please enter a 6-digit pincode.'; return; }
    const d = new Date(); let n = 0; while (n < 3) { d.setDate(d.getDate() + 1); if (d.getDay() !== 0) n++; }
    msg.innerHTML = `Arrives by <b>${d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' })}</b> · Cash on delivery available on one-time orders (sample)`;
  });

  $('[data-coupon]').addEventListener('submit', (e) => {
    e.preventDefault();
    const v = $<HTMLInputElement>('#coupon').value.trim().toUpperCase(); const msg = $('[data-couponmsg]');
    if (!v) { writeCoupon(''); msg.textContent = ''; render(); return; }
    if (v === c.rules.coupon.code) { writeCoupon(v); msg.textContent = `${v} applied: ${Math.round(c.rules.coupon.off * 100)}% off (sample coupon).`; }
    else { writeCoupon(''); msg.textContent = "That code isn't valid. In the prototype, try NANHE10."; }
    render();
  });

  // Gift options apply to the whole order and carry through to checkout.
  const g = readGift();
  const giftBox = $<HTMLInputElement>('[data-gift]'), note = $<HTMLTextAreaElement>('[data-giftnote]'), hide = $<HTMLInputElement>('[data-hideprices]');
  giftBox.checked = g.on; note.value = g.note; hide.checked = g.hidePrices; $('[data-giftbody]').hidden = !g.on;
  const saveGift = () => { writeGift({ on: giftBox.checked, note: note.value, hidePrices: hide.checked }); $('[data-giftbody]').hidden = !giftBox.checked; };
  [giftBox, hide].forEach((el) => el.addEventListener('change', saveGift)); note.addEventListener('input', saveGift);

  document.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-add]')) setTimeout(render, 0); });
  render();
</script>
