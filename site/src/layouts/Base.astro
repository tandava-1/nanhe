---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description?: string }
const { title, description = 'Nanhe: gentle baby care the way Indian homes have always done it, checked the way science does.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBF7F0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600&family=Figtree:wght@400;600;700&family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400..600,0..100;1,9..144,400..600,0..100&display=swap" />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>
      import { updateCartBadge, addToCart, toast } from '../scripts/cart';
      updateCartBadge();
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-add]');
        if (!btn) return;
        e.preventDefault();
        const slug = btn.dataset.add!;
        const sub = btn.dataset.subscribe === 'true';
        addToCart(slug, 1, sub, btn.dataset.every);
        toast(`Added ${btn.dataset.name ?? 'to cart'}${sub ? `, delivered every ${btn.dataset.every ?? '6 weeks'}` : ''}.`);
      });
    </script>
    <style>
      body { min-height: 100vh; display: flex; flex-direction: column; }
      main { flex: 1 0 auto; }
    </style>
  </body>
</html>
